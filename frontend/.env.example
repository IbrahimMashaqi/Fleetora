FLEETORA_API_URL=http://localhost:3001
# Same value as the backend FLEETORA_CLIENT_SOURCE_SECRET; signs the browser address sent to the API.
FLEETORA_CLIENT_SOURCE_SECRET=
# Header your edge proxy overwrites with the real client IP (e.g. X-Real-IP); leave empty if none.
FLEETORA_TRUSTED_CLIENT_IP_HEADER=
