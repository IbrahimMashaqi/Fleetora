# docker compose settings. Copy to .env (git-ignored) and replace every value.
POSTGRES_PASSWORD=change-me
DB_PORT=5433
FRONTEND_URL=http://localhost:3000
# Set to production only behind HTTPS (FRONTEND_URL must then be https://).
BACKEND_NODE_ENV=development
ACCESS_TOKEN_SECRET=replace-with-32-plus-random-characters
REFRESH_TOKEN_SECRET=replace-with-another-32-plus-random-characters
# Shared by backend and frontend (32+ chars).
FLEETORA_CLIENT_SOURCE_SECRET=replace-with-a-third-32-plus-random-characters
SIGNIN_RATE_LIMIT_KEY=
FLEETORA_TRUSTED_CLIENT_IP_HEADER=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
