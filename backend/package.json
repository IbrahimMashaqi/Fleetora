{
  "name": "fleetora_core_backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "build:isolated": "node test/build-isolated.cjs",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:auth:integration": "vitest run --config ./vitest.config.auth-integration.ts",
    "contract:emit": "prisma contract emit",
    "typecheck": "tsc --noEmit --declaration false --incremental false"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "12.1.3",
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "handlebars": "^4.7.10",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.4",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@prisma/cli-engine": "^0.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.20.4",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^8.0.0-rc.14",
    "socket.io-client": "4.8.4",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "preview-email": {
      "nodemailer": "$nodemailer",
      "mailparser": "3.12.4"
    },
    "@nestjs/mau": {
      "undici": "6.29.1"
    },
    "@prisma/dev": {
      "@hono/node-server": "1.19.17",
