    "execute": [
      {
        "description": "add check constraint \"staff_invitation_state_5eb9b453\"",
        "sql": "ALTER TABLE \"public\".\"staff_invitations\" ADD CONSTRAINT \"staff_invitation_state_5eb9b453\" CHECK (\"role\" IN ('COMPANY_ADMIN','ACCOUNTANT','OPERATIONS','WAREHOUSE') AND NOT (\"acceptedAt\" IS NOT NULL AND \"revokedAt\" IS NOT NULL) AND ((\"acceptedAt\" IS NULL AND \"acceptedById\" IS NULL) OR (\"acceptedAt\" IS NOT NULL AND \"acceptedById\" IS NOT NULL)) AND ((\"revokedAt\" IS NULL AND \"revokedById\" IS NULL) OR (\"revokedAt\" IS NOT NULL AND \"revokedById\" IS NOT NULL)))"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"staff_invitation_state_5eb9b453\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "staff_invitation_state_5eb9b453",
          "public",
          "\"public\".\"staff_invitations\""
        ]
