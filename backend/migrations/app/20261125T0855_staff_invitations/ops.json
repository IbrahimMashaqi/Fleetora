        "description": "create table \"staff_invitations\"",
        "sql": "CREATE TABLE \"public\".\"staff_invitations\" (\n  \"acceptedAt\" timestamptz,\n  \"acceptedById\" text,\n  \"companyId\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"email\" text NOT NULL,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"id\" text NOT NULL,\n  \"issuedById\" text NOT NULL,\n  \"revokedAt\" timestamptz,\n  \"revokedById\" text,\n  \"role\" text NOT NULL,\n  \"tokenHash\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"staff_invitation_state_ad4af2ce\" CHECK (\"role\" IN ('COMPANY_ADMIN','ACCOUNTANT') AND NOT (\"acceptedAt\" IS NOT NULL AND \"revokedAt\" IS NOT NULL) AND ((\"acceptedAt\" IS NULL AND \"acceptedById\" IS NULL) OR (\"acceptedAt\" IS NOT NULL AND \"acceptedById\" IS NOT NULL)) AND ((\"revokedAt\" IS NULL AND \"revokedById\" IS NULL) OR (\"revokedAt\" IS NOT NULL AND \"revokedById\" IS NOT NULL)))\n)",
        "params": []
      }
    ],
