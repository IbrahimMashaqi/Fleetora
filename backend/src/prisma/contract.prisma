// Add to Company: merchantMemberships MerchantMembership[]; merchantInvitations MerchantInvitation[]; merchantAccessEvents MerchantAccessEvent[]
// Add to User: merchantMembership MerchantMembership?
// Add to Merchant: memberships MerchantMembership[]; invitations MerchantInvitation[]; accessEvents MerchantAccessEvent[]
model MerchantMembership {
  @@unique([userId,companyId])
  id String @id @default(uuid())
  userId String @unique
  companyId String
  merchantId String
  role String
  status String @default("ACTIVE")
  permissions Json
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  user User @relation(fields:[userId,companyId], references:[id,companyId], onDelete:Restrict)
  company Company @relation(fields:[companyId], references:[id], onDelete:Restrict)
  merchant Merchant @relation(fields:[merchantId,companyId], references:[id,companyId], onDelete:Restrict)
  @@index([companyId,merchantId,status])
  @@index([merchantId], unique:true, where:"\"role\" = 'OWNER' AND \"status\" = 'ACTIVE'", name:"merchant_memberships_one_owner")
  @@check(expression:"\"role\" IN ('OWNER','EMPLOYEE') AND \"status\" IN ('ACTIVE','REVOKED')", name:"merchant_membership_state")
  @@map("merchant_memberships")
}
model MerchantInvitation {
  id String @id @default(uuid())
  companyId String
  merchantId String
  email String
  role String
  permissions Json
  tokenHash String @unique
  issuedById String
  acceptedById String?
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId], references:[id], onDelete:Restrict)
  merchant Merchant @relation(fields:[merchantId,companyId], references:[id,companyId], onDelete:Restrict)
  @@index([companyId,merchantId,createdAt], name:"p1_merchantinvitation_1")
  @@check(expression:"\"role\" IN ('OWNER','EMPLOYEE') AND NOT (\"acceptedAt\" IS NOT NULL AND \"revokedAt\" IS NOT NULL) AND ((\"acceptedAt\" IS NULL AND \"acceptedById\" IS NULL) OR (\"acceptedAt\" IS NOT NULL AND \"acceptedById\" IS NOT NULL))", name:"merchant_invitation_state")
  @@map("merchant_invitations")
}
model MerchantAccessEvent {
  id String @id @default(uuid())
  companyId String
  merchantId String
  actorId String
  action String
  details Json
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId], references:[id], onDelete:Restrict)
  merchant Merchant @relation(fields:[merchantId,companyId], references:[id,companyId], onDelete:Restrict)
  @@index([companyId,merchantId,createdAt], name:"p1_merchantaccessevent_1")
  @@map("merchant_access_events")
}

// Add to Company: deliveryZones DeliveryZone[]; merchantPlans MerchantPlan[];
// planZoneTariffs PlanZoneTariff[]
// Add to Merchant:
// planId String?
// pricingDiscountMinor BigInt @default(0)
// plan MerchantPlan? @relation(fields:[planId,companyId],references:[id,companyId],onDelete:Restrict)
// Add to Shipment:
// deliveryZoneId String?
// pricingPlanId String?
// pricingMode String @default("LEGACY")
// pricingPlanVersion String?
// baseDeliveryFeeMinor BigInt?
// discountMinor BigInt?
// promotionDiscountMinor BigInt?
// deliveryZone DeliveryZone? @relation(fields:[deliveryZoneId,companyId],references:[id,companyId],onDelete:Restrict)
// pricingPlan MerchantPlan? @relation(fields:[pricingPlanId,companyId],references:[id,companyId],onDelete:Restrict)
// Add Merchant check pricingDiscountMinor >= 0.
// Add Shipment check pricingMode IN ('LEGACY','FINAL_INCLUSIVE') and final-inclusive
// requires all pricing fields, feePayer='MERCHANT', serviceFeeMinor=0,
// baseDeliveryFeeMinor >= discountMinor+promotionDiscountMinor and
// deliveryFeeMinor=baseDeliveryFeeMinor-discountMinor-promotionDiscountMinor.

model DeliveryZone {
  id String @id @default(uuid())
  companyId String
  name String
  city String
  baseFeeMinor BigInt
  currency String @default("ILS")
  active Boolean @default(true)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  tariffs PlanZoneTariff[]
  shipments Shipment[]
  @@unique([id,companyId])
  @@index([companyId,city,name])
  @@check(expression: "\"baseFeeMinor\" >= 0 AND \"revision\" > 0 AND \"currency\" IN ('ILS','USD','EUR','JOD')", name:"delivery_zone_terms")
  @@map("delivery_zones")
}

model MerchantPlan {
  id String @id @default(uuid())
  companyId String
  name String
  currency String @default("ILS")
  active Boolean @default(true)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  tariffs PlanZoneTariff[]
  merchants Merchant[]
  shipments Shipment[]
  @@unique([id,companyId])
  @@index([companyId,name])
  @@check(expression: "\"revision\" > 0 AND \"currency\" IN ('ILS','USD','EUR','JOD')", name:"merchant_plan_terms")
  @@map("merchant_plans")
}

model PlanZoneTariff {
  id String @id @default(uuid())
  companyId String
  planId String
  zoneId String
  feeMinor BigInt
  discountMinor BigInt @default(0)
  promotionDiscountMinor BigInt @default(0)
  promotionLabel String?
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  plan MerchantPlan @relation(fields:[planId,companyId],references:[id,companyId],onDelete:Restrict)
  zone DeliveryZone @relation(fields:[zoneId,companyId],references:[id,companyId],onDelete:Restrict)
  @@unique([planId,zoneId,companyId])
  @@index([companyId,zoneId])
  @@check(expression: "\"feeMinor\" >= 0 AND \"discountMinor\" >= 0 AND \"promotionDiscountMinor\" >= 0 AND \"feeMinor\" >= \"discountMinor\"+\"promotionDiscountMinor\" AND (\"promotionDiscountMinor\" = 0 OR (\"promotionLabel\" IS NOT NULL AND length(trim(\"promotionLabel\")) > 0))", name:"plan_zone_tariff_amounts")
  @@map("plan_zone_tariffs")
}

model PickupRequest {
  id String @id @default(uuid())
  companyId String
  merchantId String
  method String
  status String @default("REQUESTED")
  preferredFrom DateTime?
  preferredTo DateTime?
  proposedFrom DateTime?
  proposedTo DateTime?
  confirmedFrom DateTime?
  confirmedTo DateTime?
  pickupAddress String
  latitude Float?
  longitude Float?
  notes String?
  workerId String?
  warehouseId String?
  createdBy String
  reviewedBy String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  merchant Merchant @relation(fields:[merchantId,companyId],references:[id,companyId],onDelete:Restrict)
  worker Worker? @relation(fields:[workerId,companyId],references:[id,companyId],onDelete:Restrict)
  warehouse Warehouse? @relation(fields:[warehouseId,companyId],references:[id,companyId],onDelete:Restrict)
  parcels PickupParcel[]
  @@unique([id,companyId,merchantId])
  @@index([companyId,status,createdAt], name:"p1_pickuprequest_1")
  @@index([companyId,merchantId,createdAt], name:"p1_pickuprequest_2")
  @@check(expression:"\"method\" IN ('COMPANY_PICKUP','WAREHOUSE_DROPOFF') AND \"status\" IN ('REQUESTED','PROPOSED','CONFIRMED','RECEIVED','CANCELLED') AND \"revision\" > 0",name:"pickup_request_state")
  @@check(expression:"(\"preferredFrom\" IS NULL AND \"preferredTo\" IS NULL) OR (\"preferredFrom\" IS NOT NULL AND \"preferredTo\" IS NOT NULL AND \"preferredTo\" > \"preferredFrom\")",name:"pickup_preferred_window")
  @@check(expression:"(\"confirmedFrom\" IS NULL AND \"confirmedTo\" IS NULL) OR (\"confirmedFrom\" IS NOT NULL AND \"confirmedTo\" IS NOT NULL AND \"confirmedTo\" > \"confirmedFrom\")",name:"pickup_confirmed_window")
  @@check(expression:"(\"latitude\" IS NULL AND \"longitude\" IS NULL) OR (\"latitude\" IS NOT NULL AND \"longitude\" IS NOT NULL AND \"latitude\" BETWEEN -90 AND 90 AND \"longitude\" BETWEEN -180 AND 180)",name:"pickup_coordinates")
  @@map("pickup_requests")
}
model PickupParcel {
  id String @id @default(uuid())
  companyId String
  merchantId String
  pickupId String
  shipmentId String
  active Boolean @default(true)
  receipt String @default("PENDING")
  receiptNotes String?
  receivedBy String?
  receivedAt DateTime?
  pickup PickupRequest @relation(fields:[pickupId,companyId,merchantId],references:[id,companyId,merchantId],onDelete:Restrict)
  shipment Shipment @relation(fields:[shipmentId,companyId,merchantId],references:[id,companyId,merchantId],onDelete:Restrict)
  @@unique([pickupId,shipmentId])
  @@index([shipmentId],unique:true,where:"\"active\" = true",name:"one_active_pickup_per_parcel")
  @@check(expression:"\"receipt\" IN ('PENDING','RECEIVED','MISSING','DISCREPANT') AND (\"receipt\" = 'PENDING' OR (\"receivedBy\" IS NOT NULL AND \"receivedAt\" IS NOT NULL))",name:"pickup_parcel_receipt")
  @@map("pickup_parcels")
}
