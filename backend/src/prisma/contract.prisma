// For updating the database run: npx prisma@latest db update 
// And npx prisma@latest contract emit
// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Plan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum UserRole {
  PLATFORM_ADMIN 
  COMPANY_ADMIN 
  MERCHANT 
  ACCOUNTANT 
}

enum WorkerStatus {
  ACTIVE
  OFFLINE
  ON_BREAK
  SUSPENDED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
  TRUCK
}

enum ShipmentStatus {
  CREATED
  READY_FOR_DISPATCH
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED_DELIVERY
  RESCHEDULED
  RETURNED
  ON_HOLD
}

enum ShipmentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  SHIPMENT_ASSIGNED
  DELIVERY_UPDATED
  NEW_TASK
  DELIVERY_FAILED
  AI_RECOMMENDATION
  APPROVAL_REQUIRED
}

enum AIAgentType {
  OPERATIONS_AGENT
  SUPPORT_AGENT
}

enum AIExecutionStatus {
  RUNNING
  WAITING_FOR_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

// ------------------------------------------------------------
// Organizational
// ------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  plan      Plan     @default(TRIAL)
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()  

  users      User[]
  workers    Worker[]
  vehicles   Vehicle[]
  warehouses Warehouse[]
  shipments  Shipment[]

  @@map("companies")
}

model User {
  id        String   @id @default(uuid())
  email     String?   @unique
  password  String
  fullName  String
  role      UserRole
  companyId String? // null for PLATFORM_ADMIN
  refreshToken String?
  verificationToken String?
  verificationTokenExpiresAt DateTime?
  isEmailVerified Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()  

  company           Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedShipments Shipment[]     @relation("ShipmentRequestedBy")
  approvedExecutions AIExecution[]  @relation("AIExecutionApprovedBy")
  notifications      Notification[]

  @@index([companyId])
  @@map("users")
}

model Worker {
  id          String       @id @default(uuid())
  companyId   String
  fullName    String
  phone       String
  status      WorkerStatus @default(OFFLINE)
  successRate Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt temporal.updatedAt()  

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  vehicleId      String?         @unique
  shipments      Shipment[]      @relation("ShipmentFulfilledBy")
  locationEvents LocationEvent[]
  notifications  Notification[]

  @@index([companyId])
  @@map("workers")
}

model Vehicle {
  id          String      @id @default(uuid())
  companyId   String
  type        VehicleType
  plateNumber String
  createdAt   DateTime    @default(now())
  updatedAt temporal.updatedAt()  

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker?

  @@index([companyId])
  @@map("vehicles")
}

// ------------------------------------------------------------
// Location
// ------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid())
  companyId String
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()  

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zones     Zone[]
  shipments Shipment[]

  @@index([companyId])
  @@map("warehouses")
}

model Zone {
  id          String   @id @default(uuid())
  warehouseId String
  name        String
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@map("zones")
}

// ------------------------------------------------------------
// Shipment core
// ------------------------------------------------------------

model Shipment {
  id           String           @id @default(uuid())
  companyId    String
  warehouseId  String?
  requestedBy  String // merchant who created the shipment
  workerId     String?
  status       ShipmentStatus   @default(CREATED)
  priority     ShipmentPriority @default(NORMAL)
  destination  String
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt temporal.updatedAt()  

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse  Warehouse?        @relation(fields: [warehouseId], references: [id])
  requester  User              @relation("ShipmentRequestedBy", fields: [requestedBy], references: [id])
  worker     Worker?           @relation("ShipmentFulfilledBy", fields: [workerId], references: [id])
  history    ShipmentHistory[]
  proof      ProofOfDelivery?
  executions AIExecution[]

  @@index([companyId])
  @@index([warehouseId])
  @@index([workerId])
  @@index([requestedBy])
  @@map("shipments")
}

model ShipmentHistory {
  id         String   @id @default(uuid())
  shipmentId String
  event      String
  occurredAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_history")
}

model ProofOfDelivery {
  id            String   @id @default(uuid())
  shipmentId    String   @unique
  photoUrl      String?
  signatureUrl  String?
  gpsLatitude   Float?
  gpsLongitude  Float?
  capturedAt    DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("proof_of_delivery")
}

// ------------------------------------------------------------
// Live operations
// ------------------------------------------------------------

model LocationEvent {
  id         String   @id @default(uuid())
  workerId   String
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, recordedAt])
  @@map("location_events")
}

model Notification {
  id          String            @id @default(uuid())
  type        NotificationType
  message     String
  read        Boolean           @default(false)
  createdAt   DateTime          @default(now())

  // exactly one of userId / workerId should be set
  userId   String?
  workerId String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker Worker? @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workerId])
  @@map("notifications")
}

// ------------------------------------------------------------
// AI layer
// ------------------------------------------------------------

model AIExecution {
  id          String             @id @default(uuid())
  shipmentId  String?
  agent       AIAgentType
  request     String // the natural-language prompt that triggered this run
  toolCalls   Json // ordered list of {tool, args, result}
  recommendation String?
  status      AIExecutionStatus  @default(RUNNING)
  approvedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt temporal.updatedAt()  

  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  approver User?     @relation("AIExecutionApprovedBy", fields: [approvedBy], references: [id])

  @@index([shipmentId])
  @@index([approvedBy])
  @@map("ai_executions")
}
