// For updating the database run: npx prisma@latest db update 
// And npx prisma@latest contract emit
// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Plan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum UserRole {
  PLATFORM_ADMIN 
  COMPANY_ADMIN 
  MERCHANT 
  ACCOUNTANT 
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum MembershipPrincipalType {
  STAFF
  MERCHANT
  DRIVER
}

enum PlatformGrantStatus {
  ACTIVE
  REVOKED
}

enum WorkerStatus {
  ACTIVE
  OFFLINE
  ON_BREAK
  SUSPENDED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
  TRUCK
}

enum ShipmentStatus {
  CREATED
  READY_FOR_DISPATCH
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED_DELIVERY
  RESCHEDULED
  RETURNED
  ON_HOLD
  RECEIVED_FROM_MERCHANT
  AT_WAREHOUSE
  RETURN_IN_PROGRESS
  RETURNED_TO_WAREHOUSE
  RETURNED_TO_MERCHANT
}

enum ShipmentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  SHIPMENT_ASSIGNED
  DELIVERY_UPDATED
  NEW_TASK
  DELIVERY_FAILED
  AI_RECOMMENDATION
  APPROVAL_REQUIRED
}

enum AIAgentType {
  OPERATIONS_AGENT
  SUPPORT_AGENT
}

enum AIExecutionStatus {
  RUNNING
  WAITING_FOR_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

// ------------------------------------------------------------
// Organizational
// ------------------------------------------------------------

model Company {
  merchantParcelRequests MerchantParcelRequest[]
  merchantAccessEvents MerchantAccessEvent[]
  merchantMemberships MerchantMembership[]
  merchantInvitations MerchantInvitation[]
  deliveryZones DeliveryZone[]
  merchantPlans MerchantPlan[]
  planZoneTariffs PlanZoneTariff[]
  pickupRequests PickupRequest[]
  merchantImports MerchantImport[]
  merchantSettlementRequests MerchantSettlementRequest[]

  id        String   @id @default(uuid())
  name      String
  plan      Plan     @default(TRIAL)
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()  

  users      User[]
  workers    Worker[]
  vehicles   Vehicle[]
  warehouses Warehouse[]
  shipments  Shipment[]
  memberships CompanyMembership[]
  headquarters CompanyHeadquarters?
  trackingStates DriverTrackingState[]
  businessMerchants Merchant[]
  parcelAttempts ParcelAttempt[]
  parcelReturns ParcelReturn[]
  collections CodCollection[]
  ledgerEntries MerchantLedgerEntry[]
  settlements MerchantSettlement[]
  settlementLines MerchantSettlementLine[]
  allocations SettlementAllocation[]
  payments SettlementPayment[]
  monetaryRequests MonetaryRequest[]

  @@map("companies")
}

model User {
  @@unique([id,companyId])
  merchantMembership MerchantMembership?

  id        String   @id @default(uuid())
  email     String?   @unique
  password  String
  fullName  String
  role      UserRole
  companyId String? // null for PLATFORM_ADMIN
  refreshToken String?
  verificationToken String?
  verificationTokenExpiresAt DateTime?
  isEmailVerified Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()  

  company           Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedShipments Shipment[]     @relation("ShipmentRequestedBy")
  approvedExecutions AIExecution[]  @relation("AIExecutionApprovedBy")
  notifications      Notification[]
  companyMemberships CompanyMembership[]
  platformAdminGrant PlatformAdminGrant? @relation("PlatformGrantSubject")
  issuedPlatformGrants PlatformAdminGrant[] @relation("PlatformGrantIssuer")
  revokedPlatformGrants PlatformAdminGrant[] @relation("PlatformGrantRevoker")

  @@index([companyId])
  @@map("users")
}

// Additive foundation only: legacy auth remains authoritative until approved cutover.
model CompanyMembership {
  id            String                  @id @default(uuid())
  userId        String
  companyId     String
  status        MembershipStatus        @default(INACTIVE)
  principalType MembershipPrincipalType
  createdAt     DateTime                @default(now())
  updatedAt     temporal.updatedAt()

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // Only ACTIVE rows contend; inactive and revoked affiliation history is retained.
  @@index([userId], unique: true, where: "\"status\" = 'ACTIVE'", name: "company_memberships_one_active_user")
  @@index([userId, status])
  @@index([companyId, status])
  @@map("company_memberships")
}

model PlatformAdminGrant {
  id          String              @id @default(uuid())
  userId      String              @unique
  status      PlatformGrantStatus
  createdAt   DateTime            @default(now())
  updatedAt   temporal.updatedAt()
  grantedById String?
  revokedAt   DateTime?
  revokedById String?

  user      User  @relation("PlatformGrantSubject", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("PlatformGrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy User? @relation("PlatformGrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@check(expression: "(\"status\" = 'ACTIVE' AND \"revokedAt\" IS NULL AND \"revokedById\" IS NULL) OR (\"status\" = 'REVOKED' AND \"revokedAt\" IS NOT NULL)", name: "platform_admin_grants_revocation_state")
  @@index([status])
  @@index([grantedById])
  @@index([revokedById])
  @@map("platform_admin_grants")
}

model Worker {
  pickupRequests PickupRequest[]

  id          String       @id @default(uuid())
  companyId   String
  fullName    String
  phone       String
  status      WorkerStatus @default(OFFLINE)
  successRate Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt temporal.updatedAt()  

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  vehicleId      String?         @unique
  shipments      Shipment[]      @relation("ShipmentFulfilledBy")
  locationEvents LocationEvent[]
  notifications  Notification[]

  trackingState DriverTrackingState?
  collections CodCollection[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("workers")
}

model Vehicle {
  id          String      @id @default(uuid())
  companyId   String
  type        VehicleType
  plateNumber String
  manufacturer String?
  model        String?
  createdAt   DateTime    @default(now())
  updatedAt temporal.updatedAt()  

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker?

  @@unique([companyId, plateNumber])
  @@index([companyId])
  @@map("vehicles")
}

// ------------------------------------------------------------
// Location
// ------------------------------------------------------------

model Warehouse {
  pickupRequests PickupRequest[]

  id        String   @id @default(uuid())
  companyId String
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()  

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zones     Zone[]
  shipments Shipment[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("warehouses")
}

model Zone {
  id          String   @id @default(uuid())
  warehouseId String
  name        String
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@map("zones")
}

// ------------------------------------------------------------
// Shipment core
// ------------------------------------------------------------

model Shipment {
  merchantRequests MerchantParcelRequest[]
  deliveryZoneId String?
  pricingPlanId String?
  pricingMode String @default("LEGACY")
  pricingPlanVersion String?
  baseDeliveryFeeMinor BigInt?
  discountMinor BigInt?
  promotionDiscountMinor BigInt?
  collectionMode String @default("COD")
  pickupMethod String?
  deliveryZone DeliveryZone? @relation(fields:[deliveryZoneId,companyId],references:[id,companyId],onDelete:Restrict)
  pricingPlan MerchantPlan? @relation(fields:[pricingPlanId,companyId],references:[id,companyId],onDelete:Restrict)
  pickupParcels PickupParcel[]
  @@unique([id,companyId,merchantId])
  @@check(expression:"\"pricingMode\" IN ('LEGACY','FINAL_INCLUSIVE') AND (\"pricingMode\" = 'LEGACY' OR (\"deliveryZoneId\" IS NOT NULL AND \"pricingPlanId\" IS NOT NULL AND \"pricingPlanVersion\" IS NOT NULL AND \"baseDeliveryFeeMinor\" IS NOT NULL AND \"discountMinor\" IS NOT NULL AND \"promotionDiscountMinor\" IS NOT NULL AND \"feePayer\" = 'MERCHANT' AND \"serviceFeeMinor\" = 0 AND \"discountMinor\" >= 0 AND \"promotionDiscountMinor\" >= 0 AND \"baseDeliveryFeeMinor\" >= \"discountMinor\"+\"promotionDiscountMinor\" AND \"deliveryFeeMinor\" = \"baseDeliveryFeeMinor\"-\"discountMinor\"-\"promotionDiscountMinor\"))",name:"shipment_pricing_snapshot")
  @@check(expression:"\"collectionMode\" IN ('COD','PREPAID') AND (\"pricingMode\" = 'LEGACY' OR (\"collectionMode\" = 'PREPAID' AND \"codMinor\" = 0) OR (\"collectionMode\" = 'COD' AND \"codMinor\" > 0))",name:"shipment_collection_mode")

  id           String           @id @default(uuid())
  companyId    String
  warehouseId  String?
  requestedBy  String // authenticated creator (legacy requester preserved)
  merchantId String?
  trackingNumber String? @unique
  merchantReference String?
  recipientName String?
  recipientPhone String?
  customerNotes String?
  secondaryPhone String?
  city String?
  latitude Float?
  longitude Float?
  instructions String?
  description String?
  pieces Int @default(1)
  weight Float?
  declaredValueMinor BigInt?
  codMinor BigInt @default(0)
  deliveryFeeMinor BigInt @default(0)
  returnFeeMinor BigInt @default(0)
  returnFeePolicy String @default("ON_MERCHANT_HANDOFF")
  serviceFeeMinor BigInt @default(0)
  currency String @default("ILS")
  feePayer String @default("MERCHANT")
  scheduledAt DateTime?
  custody String @default("MERCHANT")
  locationLabel String?
  locationSource String?
  locationUpdatedAt DateTime?
  responsibleActorId String?
  attemptCount Int @default(0)
  deliveredAt DateTime?
  returnedAt DateTime?
  revision Int @default(1)
  workerId     String?
  status       ShipmentStatus   @default(CREATED)
  priority     ShipmentPriority @default(NORMAL)
  destination  String
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt temporal.updatedAt()  

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse  Warehouse?        @relation(fields: [warehouseId, companyId], references: [id, companyId])
  requester  User              @relation("ShipmentRequestedBy", fields: [requestedBy], references: [id])
  worker     Worker?           @relation("ShipmentFulfilledBy", fields: [workerId, companyId], references: [id, companyId])
  history    ShipmentHistory[]
  proof      ProofOfDelivery?
  executions AIExecution[]
  merchant Merchant? @relation(fields: [merchantId, companyId], references: [id, companyId], onDelete: Restrict)
  attempts ParcelAttempt[]
  returnRecord ParcelReturn?
  collection CodCollection?
  ledgerEntries MerchantLedgerEntry[]

  @@index([companyId])
  @@index([warehouseId])
  @@index([workerId])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, merchantId])
  @@index([companyId, createdAt])
  @@check(expression: "\"pieces\" > 0 AND \"revision\" > 0 AND \"attemptCount\" >= 0 AND (\"declaredValueMinor\" IS NULL OR \"declaredValueMinor\" >= 0) AND (\"weight\" IS NULL OR \"weight\" > 0) AND \"codMinor\" >= 0 AND \"deliveryFeeMinor\" >= 0 AND \"returnFeeMinor\" >= 0 AND \"serviceFeeMinor\" >= 0", name: "shipments_parcel_amounts")
  @@index([requestedBy])
  @@map("shipments")
  @@check(expression: "\"currency\" IN ('ILS','USD','EUR','JOD') AND \"feePayer\" IN ('MERCHANT','CUSTOMER') AND \"returnFeePolicy\" IN ('NONE','ON_MERCHANT_HANDOFF')", name:"shipment_fee_policy")
  @@check(expression: "(\"latitude\" IS NULL AND \"longitude\" IS NULL) OR (\"latitude\" IS NOT NULL AND \"longitude\" IS NOT NULL AND \"latitude\" BETWEEN -90 AND 90 AND \"longitude\" BETWEEN -180 AND 180)", name:"shipment_coordinates")
}

model ShipmentHistory {
  id         String   @id @default(uuid())
  shipmentId String
  event      String
  actorId String?
  oldWorkerId String?
  newWorkerId String?
  oldWorkerName String?
  newWorkerName String?
  fromStatus String?
  toStatus String?
  note String?
  custody String?
  locationLabel String?
  occurredAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_history")
}

model ProofOfDelivery {
  id            String   @id @default(uuid())
  shipmentId    String   @unique
  photoUrl      String?
  signatureUrl  String?
  gpsLatitude   Float?
  gpsLongitude  Float?
  capturedAt    DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("proof_of_delivery")
}

// ------------------------------------------------------------
// Live operations
// ------------------------------------------------------------

model LocationEvent {
  id         String   @id @default(uuid())
  workerId   String
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, recordedAt])
  @@map("location_events")
}

// Latest state only. Legacy location_events are not imported as consented GPS.
model CompanyHeadquarters {
  companyId String @id
  latitude Float
  longitude Float
  address String?
  revision Int @default(1)
  updatedAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@check(expression: "\"latitude\" >= -90 AND \"latitude\" <= 90 AND \"longitude\" >= -180 AND \"longitude\" <= 180", name: "company_headquarters_coordinates")
  @@check(expression: "\"revision\" > 0", name: "company_headquarters_revision")
  @@map("company_headquarters")
}

model DriverTrackingState {
  workerId String @id
  companyId String
  sharing Boolean @default(false)
  sharingSessionId String
  sharingStartedAt DateTime
  revision Int @default(1)
  sequence Int @default(0)
  latitude Float?
  longitude Float?
  capturedAt DateTime?
  receivedAt DateTime?
  accuracy Float?
  speed Float?
  heading Float?
  worker Worker @relation(fields: [workerId, companyId], references: [id, companyId], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@check(expression: "(\"latitude\" IS NULL AND \"longitude\" IS NULL AND \"capturedAt\" IS NULL AND \"receivedAt\" IS NULL AND \"accuracy\" IS NULL AND \"speed\" IS NULL AND \"heading\" IS NULL) OR (\"latitude\" IS NOT NULL AND \"longitude\" IS NOT NULL AND \"capturedAt\" IS NOT NULL AND \"receivedAt\" IS NOT NULL AND \"latitude\" >= -90 AND \"latitude\" <= 90 AND \"longitude\" >= -180 AND \"longitude\" <= 180)", name: "driver_tracking_coordinates")
  @@check(expression: "\"revision\" > 0 AND \"sequence\" >= 0 AND (\"accuracy\" IS NULL OR (\"accuracy\" >= 0 AND \"accuracy\" <= 10000)) AND (\"speed\" IS NULL OR (\"speed\" >= 0 AND \"speed\" <= 100)) AND (\"heading\" IS NULL OR (\"heading\" >= 0 AND \"heading\" < 360))", name: "driver_tracking_measurements")
  @@unique([workerId, companyId])
  @@index([companyId])
  @@map("driver_tracking_states")
}

model Notification {
  id          String            @id @default(uuid())
  type        NotificationType
  message     String
  read        Boolean           @default(false)
  createdAt   DateTime          @default(now())

  // exactly one of userId / workerId should be set
  userId   String?
  workerId String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker Worker? @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workerId])
  @@map("notifications")
}

// ------------------------------------------------------------
// AI layer
// ------------------------------------------------------------

model AIExecution {
  id          String             @id @default(uuid())
  shipmentId  String?
  agent       AIAgentType
  request     String // the natural-language prompt that triggered this run
  toolCalls   Json // ordered list of {tool, args, result}
  recommendation String?
  status      AIExecutionStatus  @default(RUNNING)
  approvedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt temporal.updatedAt()  

  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  approver User?     @relation("AIExecutionApprovedBy", fields: [approvedBy], references: [id])

  @@index([shipmentId])
  @@index([approvedBy])
  @@map("ai_executions")
}

// Staff-managed business records, deliberately independent of User accounts.
model Merchant {
  parcelRequests MerchantParcelRequest[]
  accessEvents MerchantAccessEvent[]
  memberships MerchantMembership[]
  invitations MerchantInvitation[]
  planId String?
  pricingDiscountMinor BigInt @default(0)
  plan MerchantPlan? @relation(fields:[planId,companyId],references:[id,companyId],onDelete:Restrict)
  pickupRequests PickupRequest[]
  imports MerchantImport[]
  settlementRequests MerchantSettlementRequest[]
  @@check(expression:"\"pricingDiscountMinor\" >= 0",name:"merchant_pricing_discount")

  id String @id @default(uuid())
  companyId String
  name String
  contactName String
  phone String
  secondaryPhone String?
  pickupAddress String
  city String
  latitude Float?
  longitude Float?
  notes String?
  active Boolean @default(true)
  currency String
  deliveryFeeMinor BigInt
  returnFeeMinor BigInt
  returnFeePolicy String @default("ON_MERCHANT_HANDOFF")
  serviceFeeMinor BigInt @default(0)
  feePayer String
  paymentNotes String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  shipments Shipment[]
  collections CodCollection[]
  ledgerEntries MerchantLedgerEntry[]
  settlements MerchantSettlement[]
  @@unique([id,companyId])
  @@index([companyId,name], name:"parcel_ops_index_2")
  @@check(expression: "\"deliveryFeeMinor\" >= 0 AND \"returnFeeMinor\" >= 0 AND \"serviceFeeMinor\" >= 0 AND \"revision\" > 0", name:"merchant_terms_amounts")
  @@map("merchants")
  @@check(expression: "\"currency\" IN ('ILS','USD','EUR','JOD') AND \"feePayer\" IN ('MERCHANT','CUSTOMER') AND \"returnFeePolicy\" IN ('NONE','ON_MERCHANT_HANDOFF')", name:"merchant_terms_policy")
  @@check(expression: "(\"latitude\" IS NULL AND \"longitude\" IS NULL) OR (\"latitude\" IS NOT NULL AND \"longitude\" IS NOT NULL AND \"latitude\" BETWEEN -90 AND 90 AND \"longitude\" BETWEEN -180 AND 180)", name:"merchant_coordinates")
}
model ParcelAttempt {
  id String @id @default(uuid())
  companyId String
  shipmentId String
  outcome String
  reason String?
  note String?
  actorId String
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  shipment Shipment @relation(fields:[shipmentId,companyId],references:[id,companyId],onDelete:Restrict)
  @@index([companyId,shipmentId,createdAt], name:"parcel_ops_index_3")
  @@map("parcel_attempts")
}
model ParcelReturn {
  id String @id @default(uuid())
  companyId String
  shipmentId String @unique
  reason String
  note String?
  status String
  initiatedBy String
  createdAt DateTime @default(now())
  warehouseAt DateTime?
  merchantAt DateTime?
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  shipment Shipment @relation(fields:[shipmentId,companyId],references:[id,companyId],onDelete:Restrict)
  @@index([companyId,status,createdAt], name:"parcel_ops_index_4")
  @@map("parcel_returns")
  @@unique([shipmentId,companyId])
  @@check(expression: "\"status\" IN ('RETURN_IN_PROGRESS','RETURNED_TO_WAREHOUSE','RETURNED_TO_MERCHANT') AND \"reason\" IN ('CUSTOMER_REFUSED','UNREACHABLE','WRONG_ADDRESS','DAMAGED','OTHER','CUSTOMER_CANCELLED','ATTEMPTS_EXHAUSTED','MERCHANT_REQUESTED')", name:"parcel_return_stage")
}
model CodCollection {
  id String @id @default(uuid())
  companyId String
  shipmentId String @unique
  merchantId String
  workerId String?
  currency String
  amountMinor BigInt
  goodsMinor BigInt
  method String
  reference String?
  notes String?
  recordedBy String
  collectedAt DateTime @default(now())
  remittance CashRemittance?
  ledgerEntries MerchantLedgerEntry[]
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  shipment Shipment @relation(fields:[shipmentId,companyId],references:[id,companyId],onDelete:Restrict)
  merchant Merchant @relation(fields:[merchantId,companyId],references:[id,companyId],onDelete:Restrict)
  worker Worker? @relation(fields:[workerId,companyId],references:[id,companyId],onDelete:Restrict)
  @@unique([id,companyId])
  @@index([companyId,merchantId,collectedAt], name:"parcel_ops_index_7")
  @@index([companyId,workerId], name:"parcel_ops_index_8")
  @@check(expression: "\"amountMinor\" > 0 AND \"goodsMinor\" >= 0 AND \"goodsMinor\" <= \"amountMinor\"",name:"collection_amounts")
  @@map("cod_collections")
  @@unique([shipmentId,companyId])
}
model CashRemittance {
  id String @id @default(uuid())
  companyId String
  collectionId String @unique
  amountMinor BigInt
  method String
  reference String?
  notes String?
  actorId String
  createdAt DateTime @default(now())
  collection CodCollection @relation(fields:[collectionId,companyId],references:[id,companyId],onDelete:Restrict)
  @@index([companyId,createdAt], name:"parcel_ops_index_10")
  @@check(expression: "\"amountMinor\" > 0",name:"remittance_amount")
  @@map("cash_remittances")
  @@unique([collectionId,companyId])
}
model MerchantLedgerEntry {
  id String @id @default(uuid())
  companyId String
  merchantId String
  shipmentId String?
  collectionId String?
  originalId String? @unique
  currency String
  kind String
  amountMinor BigInt
  reason String
  actorId String
  postingKey String
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  merchant Merchant @relation(fields:[merchantId,companyId],references:[id,companyId],onDelete:Restrict)
  shipment Shipment? @relation(fields:[shipmentId,companyId],references:[id,companyId],onDelete:Restrict)
  collection CodCollection? @relation(fields:[collectionId,companyId],references:[id,companyId],onDelete:Restrict)
  original MerchantLedgerEntry? @relation("LedgerReversal",fields:[originalId,companyId],references:[id,companyId],onDelete:Restrict)
  reversal MerchantLedgerEntry? @relation("LedgerReversal")
  lines MerchantSettlementLine[]
  allocation SettlementAllocation?
  @@unique([id,companyId])
  @@unique([companyId,postingKey])
  @@index([companyId,merchantId,currency,createdAt], name:"parcel_ops_index_14")
  @@map("merchant_ledger_entries")
  @@unique([originalId,companyId])
  @@check(expression: "(\"kind\" = 'GOODS' AND \"amountMinor\" > 0 AND \"collectionId\" IS NOT NULL AND \"originalId\" IS NULL) OR (\"kind\" IN ('DELIVERY_FEE','RETURN_FEE') AND \"amountMinor\" < 0 AND \"shipmentId\" IS NOT NULL AND \"originalId\" IS NULL) OR (\"kind\" = 'ADJUSTMENT' AND \"amountMinor\" <> 0 AND \"originalId\" IS NULL) OR (\"kind\" = 'REVERSAL' AND \"amountMinor\" <> 0 AND \"originalId\" IS NOT NULL)", name:"merchant_ledger_kind_sign")
}
model MerchantSettlement {
  id String @id @default(uuid())
  companyId String
  merchantId String
  currency String
  status String @default("DRAFT")
  grossCollectedMinor BigInt
  deliveryFeesMinor BigInt
  returnFeesMinor BigInt
  adjustmentsMinor BigInt
  netPayableMinor BigInt
  revision Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  finalizedBy String?
  finalizedAt DateTime?
  cancelledBy String?
  cancelledAt DateTime?
  cancellationReason String?
  paidAt DateTime?
  from DateTime?
  to DateTime?
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  merchant Merchant @relation(fields:[merchantId,companyId],references:[id,companyId],onDelete:Restrict)
  lines MerchantSettlementLine[]
  allocations SettlementAllocation[]
  payments SettlementPayment[]
  @@unique([id,companyId])
  @@index([companyId,merchantId,status,createdAt], name:"parcel_ops_index_17")
  @@check(expression: "\"netPayableMinor\" > 0 AND \"revision\" > 0",name:"settlement_amount")
  @@map("merchant_settlements")
  @@check(expression: "(\"status\" = 'DRAFT' AND \"finalizedAt\" IS NULL AND \"paidAt\" IS NULL AND \"cancelledAt\" IS NULL) OR (\"status\" = 'FINALIZED' AND \"finalizedAt\" IS NOT NULL AND \"finalizedBy\" IS NOT NULL AND \"paidAt\" IS NULL AND \"cancelledAt\" IS NULL) OR (\"status\" = 'PAID' AND \"finalizedAt\" IS NOT NULL AND \"finalizedBy\" IS NOT NULL AND \"paidAt\" IS NOT NULL AND \"cancelledAt\" IS NULL) OR (\"status\" = 'CANCELLED' AND \"cancelledAt\" IS NOT NULL AND \"cancelledBy\" IS NOT NULL AND \"cancellationReason\" IS NOT NULL AND \"finalizedAt\" IS NULL AND \"paidAt\" IS NULL)", name:"merchant_settlement_state")
}
