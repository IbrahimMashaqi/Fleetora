DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fleetora"
ACCESS_TOKEN_SECRET=replace-with-a-random-development-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-development-secret
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=development-user
MAIL_PASSWORD=development-password
FRONTEND_URL=http://localhost:3000
# Shared with the frontend (32+ chars) to verify signed client-source headers; required in production.
FLEETORA_CLIENT_SOURCE_SECRET=
# Dedicated HMAC key for sign-in rate-limit counters; falls back to RECOVERY_RATE_LIMIT_KEY, then ACCESS_TOKEN_SECRET.
SIGNIN_RATE_LIMIT_KEY=
